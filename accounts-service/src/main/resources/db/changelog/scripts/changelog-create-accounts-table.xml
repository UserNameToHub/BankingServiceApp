<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1" author="gineika">
        <preConditions onFail="MARK_RAN">
            <and>
                <not>
                   <tableExists tableName="accounts"/>
                </not>
                <dbms type="postgresql"/>
            </and>
        </preConditions>
        <createTable tableName="accounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="login" type="varchar(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="DECIMAL(10,2)" defaultValue="0.00"/>
            <column name="birthday" type="DATE"/>
        </createTable>
        <rollback>
            <dropTable tableName="accounts"/>
        </rollback>
    </changeSet>

    <changeSet id="2" author="gineika">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="accounts"/>
                <not>
                    <indexExists indexName="idx_account"/>
                </not>
            </and>
        </preConditions>
        <createIndex tableName="accounts" indexName="idx_account">
            <column name="login"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>